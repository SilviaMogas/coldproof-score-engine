# Backend API base URL.
VITE_API_BASE_URL=https://coldproof.pipe.com.ar/api

# --- AWS Cognito (OIDC / Hosted UI) ---
# OIDC issuer for the user pool (discovery is served from here).
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-2.amazonaws.com/us-east-1_xxxxxxxxx
# App client id (must be a Hosted UI enabled public client, no secret).
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Where Cognito redirects back after login. Must be an allowed callback URL.
VITE_REDIRECT_URI=https://coldproof.pipe.com.ar/
# OAuth scopes to request.
VITE_COGNITO_SCOPE=openid email profile
# Full Hosted UI domain (https), used for sign-out. Example:
# https://your-domain.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=
# Where Cognito redirects after logout. Must be an allowed sign-out URL.
VITE_COGNITO_LOGOUT_URI=https://coldproof.pipe.com.ar/

# Cognito group required to access the backoffice.
VITE_ADMIN_GROUP=admin
