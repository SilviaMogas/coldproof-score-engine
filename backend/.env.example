# --- HTTP server ---
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# --- Logging ---
# level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Colorized, human-readable logs for local dev. Set to false for JSON logs.
LOG_PRETTY=true

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173

# --- Persistence ---
# memory: ephemeral, lost on restart | sqlite: durable file-backed store
PERSISTENCE=memory
# Path to the SQLite database file (only used when PERSISTENCE=sqlite).
SQLITE_PATH=./data/coldproof.db

# --- AWS Cognito (first identity provider) ---
# The backend verifies JWT access tokens issued by this user pool.
# Region is derived from the user pool id, but kept here for future AWS calls.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Which token to accept from the Authorization: Bearer header.
# access (recommended for APIs) | id
COGNITO_TOKEN_USE=access

# --- Blockchain adapter ---
# hedera keeps the existing HCS/HBAR implementation.
# sepolia selects the Ethereum adapters without changing business use cases.
BLOCKCHAIN_PROVIDER=hedera

# --- Hedera Consensus Service (immutable reading log) ---
# When operator credentials are set, each ingested /readings entry is mirrored
# to an HCS topic (same as the standalone gateway PoC). Leave the operator
# fields blank to disable HCS in local dev (readings are still persisted).
# network: testnet | previewnet | mainnet
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxxxx
HEDERA_OPERATOR_KEY=
# Reuse a fixed topic across restarts. Leave blank to auto-create on first use.
HEDERA_TOPIC_ID=

# --- Escrow settlement (Option A) ---
# When the operator credentials, topic and this shipper account are all set,
# deliveries can hold HBAR in escrow (the operator account acts as the escrow
# float) and settle from the HCS log on finish: released to the carrier's
# hederaAccountId, or refunded here on a breach / missing readings.
SHIPPER_ACCOUNT_ID=0.0.xxxxxxx

# --- Ethereum Sepolia (used when BLOCKCHAIN_PROVIDER=sepolia) ---
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-key
# Backend/oracle wallet. It writes consensus events and holds the escrow float,
# matching the role of HEDERA_OPERATOR_ID + HEDERA_OPERATOR_KEY.
SEPOLIA_ORACLE_PRIVATE_KEY=
# ColdProofConsensus deployment address and deployment block.
SEPOLIA_CONSENSUS_ADDRESS=
SEPOLIA_CONSENSUS_START_BLOCK=0
# Wallet refunded when the cold chain fails.
SEPOLIA_SHIPPER_ADDRESS=

# --- Secure-box unlock authorization ---
# The backend signs unlock commands with this Ed25519 seed (32-byte / 64 hex
# chars); provisioned devices verify commands with the matching public key
# (fetch it from GET /unlock/public-key). Leave blank to generate an ephemeral
# key in dev (it changes on every restart, so devices would reject it).
UNLOCK_SIGNING_KEY=
# Seconds an issued unlock command stays valid.
UNLOCK_TTL_SECONDS=60
# Cold-chain range; a reading outside it blocks the box from unlocking.
TEMP_MIN_C=2
TEMP_MAX_C=20
