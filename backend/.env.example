# --- HTTP server ---
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# --- Logging ---
# level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Colorized, human-readable logs for local dev. Set to false for JSON logs.
LOG_PRETTY=true

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173

# --- AWS Cognito (first identity provider) ---
# The backend verifies JWT access tokens issued by this user pool.
# Region is derived from the user pool id, but kept here for future AWS calls.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Which token to accept from the Authorization: Bearer header.
# access (recommended for APIs) | id
COGNITO_TOKEN_USE=access
