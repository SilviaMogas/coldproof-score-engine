# --- HTTP server ---
HOST=0.0.0.0
PORT=3001
NODE_ENV=development

# --- Logging ---
LOG_LEVEL=info
LOG_PRETTY=true

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Persistence ---
PERSISTENCE=memory
SQLITE_PATH=./data/coldproof.db

# --- AWS Cognito ---
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_TOKEN_USE=access

# --- Blockchain adapter ---
BLOCKCHAIN_PROVIDER=hedera

# --- Hedera Consensus Service ---
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=0.0.xxxxxxx
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
SHIPPER_ACCOUNT_ID=0.0.xxxxxxx

# --- Existing Ethereum Sepolia integration ---
SEPOLIA_ORACLE_PRIVATE_KEY=
SEPOLIA_CONSENSUS_ADDRESS=
SEPOLIA_CONSENSUS_START_BLOCK=0
SEPOLIA_SHIPPER_ADDRESS=

# --- Secure-box unlock authorization ---
UNLOCK_SIGNING_KEY=
UNLOCK_TTL_SECONDS=60
TEMP_MIN_C=2
TEMP_MAX_C=20

# --- ColdProof Score Engine ---
GRAPH_ENDPOINT=
GRAPH_API_KEY=
GRAPH_API_KEY_HEADER=Authorization
GRAPH_ALLOW_PARTIAL_ERRORS=false
GRAPH_FIXTURE_MODE=false
GRAPH_FIXTURE_FILE=./fixtures/carrier-metrics.json

ENS_ADMIN_ADDRESS=0x16a30d989a440c1303ddb33a38b730e96528eea9
ENS_ADMIN_PRIVATE_KEY=
ENS_PARENT_NAME=coldproof.eth
SEPOLIA_RPC_URL=

SCORE_VERSION=1.0
SCORE_MIN_CHANGE=1
SCORE_SYNC_CONFIRM=false
