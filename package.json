  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
