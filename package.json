{
  "name": "coldproof-score-engine",
  "version": "1.0.0",
  "description": "Deterministic carrier reputation scoring from The Graph to ENSv2",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "scores:plan": "tsx src/commands/plan-scores.ts",
